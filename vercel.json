{
  "version": 2,
  "builds": [
    { "src": "api/auth.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/auth.js" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/images/(.*)", "dest": "/public/images/$1" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/mobile.css", "dest": "/public/mobile.css" },
    { "src": "/dashboard", "dest": "/api/auth.js" },
    { "src": "/client", "dest": "/api/auth.js" },
    { "src": "/sales-orders", "dest": "/api/auth.js" },
    { "src": "/reports", "dest": "/api/auth.js" },
    { "src": "/docs-report", "dest": "/api/auth.js" },
    { "src": "/adminclient", "dest": "/api/auth.js" },
    { "src": "/audit-logs", "dest": "/api/auth.js" },
    { "src": "/trucks", "dest": "/api/auth.js" },
    { "src": "/ttsd-checklist", "dest": "/api/auth.js" },
    { "src": "/users", "dest": "/api/auth.js" },
    { "src": "/tutorial", "dest": "/api/auth.js" },
    { "src": "/recycle-bin", "dest": "/api/auth.js" },
    { "src": "/", "dest": "/api/auth.js" },
    { "src": "/first-login", "dest": "/api/auth.js" },
    { "src": "/terms", "dest": "/api/auth.js" },
    { "src": "/privacy", "dest": "/api/auth.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}